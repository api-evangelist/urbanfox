{
  "opencollection": "1.0.0",
  "info": {
    "name": "UrbanFox Customer Cases Snippet API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.demo-retail.urbanfox.io/v2/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Snippet",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get integration snippets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.{tenant_slug}.urbanfox.io/v2/:tenant_slug/snippet",
            "params": [
              {
                "name": "tenant_slug",
                "value": "",
                "type": "path",
                "description": "Tenant DNS slug (lowercase letters, digits, and hyphens; 3-100 characters)."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.demo-retail.urbanfox.io/v2/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve integration snippets and identifiers for a tenant."
        }
      ]
    }
  ],
  "bundled": true
}