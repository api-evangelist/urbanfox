{
  "item": [
    {
      "id": "d19f0c42-f3bf-4fa5-a36b-e37711298ca7",
      "name": "Metrics",
      "description": {
        "content": "Aggregated tenant metrics and time-series reporting.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5d0f406d-1dc1-4d07-bbba-3b65be9be075",
          "name": "Get tenant metrics",
          "request": {
            "name": "Get tenant metrics",
            "description": {
              "content": "Retrieve tenant activity metrics for a selected date range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                ":tenant_slug",
                "metrics"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<dateTime>",
                  "description": "(Required) Inclusive start of the metrics query window (RFC 3339 / ISO 8601 UTC, milliseconds optional)."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<dateTime>",
                  "description": "(Required) Exclusive end of the metrics query window (RFC 3339 / ISO 8601 UTC, milliseconds optional). Events at exactly `end_date` are not included; must be strictly greater than `start_date`."
                },
                {
                  "disabled": false,
                  "key": "aggregation",
                  "value": "<string>",
                  "description": "Time bucket size for the returned series. Omit to receive raw, non-aggregated data points. When set, the response includes a data point for every interval in `[start_date, end_date)` (half-open: `start_date` inclusive, `end_date` exclusive), filling missing intervals with zero values. Range limits: `minute` requires `end_date - start_date <= 7 days`; `hour` requires `end_date - start_date <= 90 days`; `day`, `week`, `month`, `quarter`, `year` have no explicit limit."
                },
                {
                  "disabled": false,
                  "key": "metric",
                  "value": "<string>",
                  "description": "Specific metric to return (`timestamp`, `total_events`, `guest_sessions`, `non_guest_sessions`, `unique_sessions`, `unique_ids`, `session_starts`). Omit to receive every metric for each data point."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "{{tenant_slug}}",
                  "key": "tenant_slug",
                  "description": "Tenant DNS slug (lowercase, hyphenated)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "create:enduseraccount delete:enduseraccount read:case read:cases read:enduseraccount read:enduseraccounts read:metrics read:snippet read:tenant read:tenant_auth_secret update:case update:enduseraccount update:tenant_auth_secret"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.demo-retail.urbanfox.io/v2/oauth/token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
