{
  "opencollection": "1.0.0",
  "info": {
    "name": "UrbanFox Customer Cases OAuth API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.demo-retail.urbanfox.io/v2/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "OAuth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Issue OAuth token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.{tenant_slug}.urbanfox.io/v2/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Generate an OAuth access token for machine-to-machine API access."
        }
      ]
    }
  ],
  "bundled": true
}